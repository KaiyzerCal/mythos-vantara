# Copy to .env for local runs or a Docker Compose deploy (Hetzner, any VPS).
# Railway reads these from its own dashboard/CLI instead — see README.md.

# Shared secret between this service and mavis-hyperframes. Generate with
# `openssl rand -hex 32`. The service refuses to start without one.
RENDER_KEY=

# Same project mavis-hyperframes and the rest of the app talk to — this
# service writes render_jobs rows and uploads finished videos to the
# vault-media bucket in it. Find both in the Supabase dashboard under
# Project Settings → API. The service role key bypasses RLS; keep it out of
# any client-facing surface.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — see README.md's Configuration table for defaults.
# RENDER_QUALITY=standard
# MAX_CONCURRENT_RENDERS=1
# PORT=8080
